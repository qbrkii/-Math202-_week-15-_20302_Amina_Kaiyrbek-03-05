def bezier2(p0, p1, p2, t):
    x = (1 - t)**2 * p0[0] + 2 * (1 - t) * t * p1[0] + t**2 * p2[0]
    y = (1 - t)**2 * p0[1] + 2 * (1 - t) * t * p1[1] + t**2 * p2[1]
    return x, y

def bezier3(p0, p1, p2, p3, t):
    x = (1 - t)**3 * p0[0] + 3 * (1 - t)**2 * t * p1[0] + 3 * (1 - t) * t**2 * p2[0] + t**3 * p3[0]
    y = (1 - t)**3 * p0[1] + 3 * (1 - t)**2 * t * p1[1] + 3 * (1 - t) * t**2 * p2[1] + t**3 * p3[1]
    return x, y

def bezier4(p0, p1, p2, p3, p4, t):
    x = ((1 - t)**4 * p0[0] + 4 * (1 - t)**3 * t * p1[0] +
         6 * (1 - t)**2 * t**2 * p2[0] + 4 * (1 - t) * t**3 * p3[0] + t**4 * p4[0])
    y = ((1 - t)**4 * p0[1] + 4 * (1 - t)**3 * t * p1[1] +
         6 * (1 - t)**2 * t**2 * p2[1] + 4 * (1 - t) * t**3 * p3[1] + t**4 * p4[1])
    return x, y

t_values = [i / 100 for i in range(101)]

ctrl2 = [(0, 0), (1, 2), (2, 0)]
ctrl3 = [(0, 0), (1, 3), (2, -1), (3, 0)]
ctrl4 = [(0, 0), (1, 4), (2, 2), (3, -2), (4, 0)]

print("2nd Order Bézier Curve:")
print("x\ty")
for t in t_values:
    x, y = bezier2(*ctrl2, t)
    print(f"{x:.4f}\t{y:.4f}")

print("\n3rd Order Bézier Curve:")
print("x\ty")
for t in t_values:
    x, y = bezier3(*ctrl3, t)
    print(f"{x:.4f}\t{y:.4f}")

print("\n4th Order Bézier Curve:")
print("x\ty")
for t in t_values:
    x, y = bezier4(*ctrl4, t)
    print(f"{x:.4f}\t{y:.4f}")
